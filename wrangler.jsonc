{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "moffittsite",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only these paths run src/worker.js (sign-in check + todo and chat APIs);
    // everything else is served straight from public/.
    "run_worker_first": [
      "/todo", "/todo/*", "/plugins", "/plugins/*", "/sandbox/*", "/chat", "/chat/*",
      "/login", "/login/*", "/signup", "/logout",
      "/dashboard", "/dashboard/*", "/account", "/account/*", "/admin", "/admin/*",
      "/notifications", "/notifications/*", "/recipes", "/recipes/*", "/_matrix/push/v1/notify",
      "/mcp", "/books/api", "/books/api/*", "/app", "/app/*", "/.well-known/assetlinks.json"
    ]
  },

  // Keep variables added in the dashboard when Workers Builds deploys. Without
  // this, every deploy deletes any dashboard variable of type "Text" that
  // isn't listed below (secrets are always kept).
  "keep_vars": true,

  "vars": {
    // "open" shows "Create an account"; "closed" stops new sign-ups.
    "SIGNUPS": "open",
    // Stops accepting new accounts at this many.
    "MAX_USERS": "100",
    // Password hashing strength (PBKDF2 rounds, at most 100000). Lower it if
    // sign-ins fail with "exceeded resource limits" on the Workers free plan.
    "PASSWORD_ITERATIONS": "100000",
    // Sender for confirmation and password-reset emails. Email stays off until
    // the RESEND_API_KEY secret is also set. See README.
    "MAIL_FROM": "Sintfoap <no-reply@sintfoap.xyz>",
    // Who push services contact about our notifications (VAPID "sub"). Push
    // stays off until the VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY secrets are set.
    "PUSH_CONTACT": "https://sintfoap.xyz",
    // The site's own address, for links that other services call back
    // (Matrix pushers: <SITE_URL>/_matrix/push/v1/notify).
    "SITE_URL": "https://sintfoap.xyz"
  },
  // Also needed, set as a secret (not here): ADMIN_CLAIM_CODE, which lets one
  // account claim admin while there is none. See README.
  // CHAT_BRIDGE_KEY, also a secret, encrypts the tokens people give Chat to
  // connect their other chat platforms (Matrix). Without it connections are off.
  // GIPHY_API_KEY, also a secret, is a GIPHY API key (developers.giphy.com) for
  // chat's GIF picker; GIF_API_KEY, a KLIPY key, works instead. Without either
  // the picker is off. See src/gifs.js.

  // Branch builds run `wrangler preview`, which takes its settings from here.
  // Previews have no database, so signing in there fails closed.
  "previews": {
    "vars": {
      "SIGNUPS": "closed",
      "MAX_USERS": "0",
      "PASSWORD_ITERATIONS": "100000",
      "MAIL_FROM": "Sintfoap <no-reply@sintfoap.xyz>",
      "PUSH_CONTACT": "https://sintfoap.xyz",
      "SITE_URL": "https://sintfoap.xyz"
    }
  },

  // Drift's notification reminders, and syncing chat connections for theirs
  // (scheduled() in src/worker.js).
  "triggers": { "crons": ["*/5 * * * *"] },

  // Accounts and todo lists (Storage & Databases → D1 → moffittsite).
  // Previews don't get this binding, so test branches never touch real data.
  "d1_databases": [
    { "binding": "TODO_DB", "database_name": "moffittsite", "database_id": "c34cd7d8-cf0d-460d-8b4f-c0e627a0dfb3" }
  ]
}
